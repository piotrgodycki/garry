{
  "name": "garry-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Garry desktop app: the dashboard with garry serve built in, for macOS, Windows and Linux",
  "author": "Piotr Godycki",
  "homepage": "https://github.com/piotrgodycki/garry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrgodycki/garry.git",
    "directory": "garry-desktop"
  },
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/electron.mjs .",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.6",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0",
    "qrcode": "1.5.4",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "dev.garry.desktop",
    "productName": "Garry",
    "copyright": "Copyright (c) 2026 Piotr Godycki",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "ui/**",
      "skills/**",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Piotr Godycki"
    },
    "artifactName": "Garry-${version}-${os}-${arch}.${ext}"
  }
}
