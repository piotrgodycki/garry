#!/bin/sh
# Switched on by `pnpm install` (core.hooksPath = .githooks).
set -e
node --import tsx garry-tool/src/cli.ts hooks check

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
echo "$staged" | xargs npx --no-install prettier --check --ignore-unknown
code=$(echo "$staged" | grep -E '\.(ts|tsx|js|mjs)$' || true)
[ -z "$code" ] || echo "$code" | xargs npx --no-install eslint --no-warn-ignored
