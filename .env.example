# Copy to .env and fill in. .env is never committed.

# Fine grained GitHub token limited to the repositories Garry manages
# (contents and pull requests). Optional: without it GitHub views stay derived.
GARRY_GITHUB_TOKEN=

# Required to reach Garry from a phone or any other device. Every /api request
# must carry it. Generate one with: openssl rand -hex 24
GARRY_ACCESS_TOKEN=

# Address the server listens on. 127.0.0.1 (default) is this machine only;
# 0.0.0.0 makes it reachable on your network and needs GARRY_ACCESS_TOKEN.
GARRY_HOST=127.0.0.1
