{
  "name": "garry-tool",
  "version": "0.0.0",
  "description": "Garry tool: the garry CLI (interactive scaffolding wizard and SDLC orchestration)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piotrgodycki/garry.git",
    "directory": "garry-tool"
  },
  "type": "module",
  "bin": {
    "garry": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli.ts --help",
    "scaffold": "tsx src/cli.ts scaffold",
    "serve": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "picocolors": "^1.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.5",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
