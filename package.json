{
  "name": "garry-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,magenta \"pnpm serve\" \"pnpm ui\"",
    "serve": "tsx garry-tool/src/cli.ts serve",
    "ui": "pnpm --filter garry-ui dev",
    "garry": "tsx garry-tool/src/cli.ts",
    "scaffold": "tsx garry-tool/src/cli.ts scaffold",
    "typecheck": "pnpm -r typecheck",
    "dashcheck": "node scripts/check-no-emdash.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "desktop": "pnpm -C garry-desktop start",
    "mobile": "pnpm -C garry-mobile start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
